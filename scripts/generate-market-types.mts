/** Generate application types from the actual migration in embedded Postgres. */
import { PGlite } from '@electric-sql/pglite';
import fs from 'node:fs/promises';
const db=new PGlite();
try {
  await db.exec('create role anon; create role authenticated; create role service_role bypassrls;');
  for(const file of (await fs.readdir('supabase/migrations')).filter((name)=>/_(usda_market_history|usda_revision_acceptance|data_explorer|active_market_collection)\.sql$/.test(name)).sort()) {
    await db.exec(await fs.readFile(`supabase/migrations/${file}`,'utf8'));
  }
  const columns=await db.query<{table_name:string;column_name:string;data_type:string;is_nullable:string;column_default:string|null;is_identity:string}>(
    "select table_name,column_name,data_type,is_nullable,column_default,is_identity from information_schema.columns where table_schema='public' order by table_name,ordinal_position");
  const functions=await db.query<{name:string;args:string;result:string}>(
    "select p.proname as name,pg_get_function_arguments(p.oid) as args,pg_get_function_result(p.oid) as result from pg_proc p join pg_namespace n on n.oid=p.pronamespace where n.nspname='public' and p.prorettype<>'trigger'::regtype order by p.proname");
  const type=(sql:string)=>/json/.test(sql)?'Json':/^(integer|bigint|numeric|real|double precision)$/.test(sql)?'number':sql==='boolean'?'boolean':sql==='void'?'undefined':'string';
  let output=`// Generated by npm run market:types from the market-history migration. Do not edit.\nexport type Json = string | number | boolean | null | Json[] | { [key: string]: Json | undefined };\ntype Table<Row, Insert> = { Row: Row; Insert: Insert; Update: Partial<Row>; Relationships: [] };\nexport interface MarketDatabase { public: { Tables: {\n`;
  for(const table of [...new Set(columns.rows.map(c=>c.table_name))]) {
    const fields=columns.rows.filter(c=>c.table_name===table);
    const declarations=(insert:boolean)=>fields.map(c=>`${JSON.stringify(c.column_name)}${insert&&(c.column_default!==null||c.is_nullable==='YES'||c.is_identity==='YES')?'?':''}: ${type(c.data_type)}${c.is_nullable==='YES'?' | null':''};`).join('\n');
    output+=`${JSON.stringify(table)}: Table<{${declarations(false)}},{${declarations(true)}}>;\n`;
  }
  output+='}; Views: Record<string, never>; Functions: {\n';
  for(const fn of functions.rows) {
    const args=fn.args?`{ ${fn.args.split(', ').map(arg=>{const [name,...sql]=arg.split(' ');return `${name}: ${type(sql.join(' '))};`;}).join(' ')} }`:'Record<string, never>';
    output+=`${JSON.stringify(fn.name)}: { Args: ${args}; Returns: ${type(fn.result)} };\n`;
  }
  output+='}; Enums: Record<string, never>; CompositeTypes: Record<string, never> } }\n';
  await fs.writeFile('src/types/market-database.ts',output);
} finally { await db.close(); }
