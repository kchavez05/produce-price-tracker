  ],
  "decisions": [
    {
      "id": "PQ-01",
      "name": "US customary measurement",
      "proposal": "Use exact same-dimension US customary conversions. Bare oz is mass only when the source establishes mass. No global fo alias. No nutrition-serving-derived package quantity.",
      "factors": {
        "tsp_to_mL": "4.92892159375",
        "tbsp_to_mL": "14.78676478125",
        "cup_to_mL": "236.5882365",
        "US_fl_oz_to_mL": "29.5735295625",
        "oz_to_g": "28.349523125",
        "lb_to_g": "453.59237"
      }
    },
    {
      "id": "PQ-02",
      "name": "Versioned exact product admission",
      "proposal": "Admit only reviewed product/item revisions and food forms, preserving scoped recipe and dietary requirements. Initial seed references are discovery references, not copied offers or approved runtime mappings.",
      "scopedUnitException": {
        "provider": "KROGER_PRODUCTION",
        "productId": "0005160000004",
        "label": "15 fo",
        "normalizedAmount": "15",
        "normalizedUnit": "US_fl_oz",
        "manufacturerGTIN14": "00051600000044",
        "evidenceURL": "https://www.kraftheinz.com/lea-perrins/products/00051600000044-the-original-worcestershire-sauce",
        "claims": [
          "manufacturer_gluten_free"
        ],
        "limits": "Exact US Original product/size, corroborated source revision only. No broad fo alias or automatic pantry compatibility edge."
      }
    },
    {
      "id": "PQ-03",
      "name": "Canned recipe basis",
      "proposal": "Use labeled unopened-can net contents for the five reviewed canned requirements, not drained food mass. Require explicit recipe requirement basis and source canned-form evidence. Missing/stale saved basis falls back; no yield rule or cooking-method change."
    },
    {
      "id": "PQ-04",
      "name": "Regular location quote",
      "proposal": "Only Production location price.regular may become observed pricing after external unconditional USD semantics gate. Never use promo, nationalPrice, regularPerUnitEstimate or promoPerUnitEstimate. Preserve all counterevidence. Unknown conditions/currency are ineligible."
    },
    {
      "id": "PQ-05",
      "name": "Current quote and store selection",
      "proposal": "Same America/Denver day, selected verified market/location, effective and unexpired. inStore means sold at location, not guaranteed inventory. Reject explicit out of stock; unknown inventory is disclosed. Select lowest exact compatible allocated unit cost, then newest observation, locationId, productId and itemId ascending. Resolve conflicting revisions first."
    },
    {
      "id": "PQ-06",
      "name": "Exact allocated costs",
      "proposal": "Represent money in integer cents and quantities/conversions as bounded rational decimals. Sum exact costs per recipe, round once half-up, reconcile detail cents by largest remainder and stable requirement key. Shopping sums the authoritative allocated recipe rows. No package-checkout claim or invented savings."
    },
    {
      "id": "PQ-07",
      "name": "Fallback and shared context",
      "proposal": "Observed then existing exact-unit static then unpriced. Yes removes additional need regardless of quantity. No preserves need. Immutable context includes date, market, locations, offers/revisions, source rules and serving count. Current/saved/shopping reuse the evaluator without inventory or saved-recipe writes."
    },
    {
      "id": "PQ-08",
      "name": "Operations and retention",
      "proposal": "No persistent Kroger content cache or new raw quote fixtures absent permitted duration/rights. Request-only processing by default; independently disable observed pricing. Respect provider quota, bounded concurrency/timeouts/backoff, coalesce only if permitted, and keep credentials server-side. Retention/use-case gates remain external."
    }
  ],
