{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run catalog:build -- --check)",
      "Bash(npm ci)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Bash(git push* main)",
      "Bash(git push*:main)",
      "Bash(git push*/main)",
      "Bash(git push* develop)",
      "Bash(git push*:develop)",
      "Bash(git push*/develop)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production*)",
      "Read(./.env.development*)",
      "Read(./.env.test*)",
      "Read(./.env.vercel*)"
    ]
  }
}
