# Mead, CO (80542) Produce & Commodity Meal-Prep Tracker
# Note: The app works 100% out-of-the-box with ZERO API keys using the live 80542 Flipp circular feeds
# (King Soopers & Safeway) + built-in USDA Mountain Region baselines and the internal Stew/Casserole engine.

# Optional 1: Google Gemini Free Tier API Key (https://aistudio.google.com/apikey)
# Enables dynamic AI 3-Dish Meal Prep generation & custom remixing with gemini-2.5-flash
GEMINI_API_KEY=

# Optional 2: USDA MyMarketNews (MARS API v1.2) Key (https://mymarketnews.ams.usda.gov/)
# Enables live API queries to reports 3324 (Produce), 3228 (Beef), 2868 (Pork), 2756 (Chicken), 2995 (Dairy)
USDA_MARS_API_KEY=

# Optional 3: Kroger Developer API Credentials (https://developer.kroger.com/)
# Enables querying unadvertised shelf prices at local King Soopers locations near 80542
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_LOCATION_ID=01400100

# Default Zip Code (Mead, CO)
NEXT_PUBLIC_DEFAULT_ZIP=80542

# Optional 4: Supabase Auth & PostgreSQL RLS Cloud Sync (https://supabase.com/)
# Enables Google SSO, Sign in with Apple, and multi-device PostgreSQL RLS cloud sync.
# If omitted, PantryBot operates in Zero-Key Local Mode using localStorage + SQLite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
