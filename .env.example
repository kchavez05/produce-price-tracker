# PantryBot application and operator configuration (blank credentials are intentional).
# Manual pantry entry and deterministic recipes work without API keys.
# For a fresh local file only: cp .env.example .env.local
# If Vercel already generated .env.local, merge missing entries; do not replace it.
# Setup, generated-variable exceptions, and spike-only loading:
# docs/wiki/API-Keys-and-Local-Setup.md

# Application AI: server-only Gemini key; also used by the isolated #731 runner.
# Get a key at https://aistudio.google.com/apikey; verify account pricing/terms.
GEMINI_API_KEY=

# AI provider comparison #731 ONLY (not used by the application).
# Optional for normal app use; the approved full comparison needs all four providers.
# These are direct provider credentials, not Vercel AI Gateway credentials.
# GOOGLE_API_KEY is a runner-only fallback when GEMINI_API_KEY is blank.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required only for an Anthropic key not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
DEEPGRAM_API_KEY=
# Keys alone do not qualify a run: follow docs/research/ai-provider-spike-731/EXECUTION.md.

# USDA MyMarketNews: authenticated weekly ingestion and operator commands only.
# https://mymarketnews.ams.usda.gov/ (never queried by dashboard requests).
USDA_MARS_API_KEY=
# Enable only after migrations and authenticated report validation; production only.
USDA_INGEST_ENABLED=false

# Kroger market-discovery connector (https://developer.kroger.com/).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_LOCATION_ID=01400100

# Default Zip Code (Mead, CO).
NEXT_PUBLIC_DEFAULT_ZIP=80542

# Optional Supabase cloud authentication/sync; omit for local guest operation.
# These are the exact public variable names the current application reads.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is not currently read as an alias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret key for market history, USDA ingestion, refresh audits.
# Apply required migrations first. Never prefix this key with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY is not read as an alias by this application.
SUPABASE_SECRET_KEY=

# Protects scheduled GET requests. Set a random secret in Vercel production;
# Vercel sends Authorization: Bearer <CRON_SECRET>. Not a grocery data API key.
CRON_SECRET=

# Virtual Pantry is the only inventory path. Apply all additive pantry migrations
# before deployment; there is no Pantry rollout flag or Freezer fallback.
# Optional catalog rollback: leave blank for the bundled current catalog.
# Only versions retained in src/data/cooking-catalog.json are supported.
NEXT_PUBLIC_PANTRYBOT_CATALOG_VERSION=

# Approved USDA barcode lookup. Keep off until artifact/deployment/rate-limit checks pass.
PANTRYBOT_BARCODE_LOOKUP_ENABLED=false
# Camera additionally requires lookup, pantry, and real-device qualification.
PANTRYBOT_BARCODE_CAMERA_ENABLED=false
# Shared deployed IP enforcement must be verified before production lookup can run.
PANTRYBOT_BARCODE_SHARED_LIMIT_VERIFIED=false
# Optional local override; deployable default is data/fdc-barcode-index (never public/).
PANTRYBOT_BARCODE_INDEX_DIR=

# Optional local/operator overrides. Blank values retain built-in defaults.
# SQLite defaults to data/mead-price-history.sqlite; :memory: is ephemeral (for isolated tests).
PANTRYBOT_SQLITE_PATH=
# USDA catalog CSV importer defaults to python3; requires Python 3.10+.
# npm run catalog:fdc does not auto-load .env.local; export this or load it explicitly.
FDC_IMPORT_PYTHON=

# Deliberately omitted: VERCEL_*, NX_*, TURBO_* platform/tool metadata;
# unused POSTGRES_* and Supabase integration aliases. See the setup guide.
