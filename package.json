{
  "name": "produce-price-tracker",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "openapi:export": "node -e \"const fs = require('fs'); const { PANTRYBOT_OPENAPI_SPEC } = require('./src/lib/openapi/spec.ts'); fs.mkdirSync('./docs', { recursive: true }); fs.mkdirSync('./public', { recursive: true }); fs.writeFileSync('./docs/openapi.json', JSON.stringify(PANTRYBOT_OPENAPI_SPEC, null, 2) + '\\n'); fs.writeFileSync('./public/openapi.json', JSON.stringify(PANTRYBOT_OPENAPI_SPEC, null, 2) + '\\n'); console.log('Emitted docs/openapi.json and public/openapi.json');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:regression": "vitest run tests/regression",
    "test:ci:develop": "vitest run tests/unit tests/smoke",
    "test:ci:main": "vitest run tests/unit tests/smoke tests/regression"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.61.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.34.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
