{
  "name": "produce-price-tracker",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "openapi:export": "node -e \"const fs = require('fs'); const { PANTRYBOT_OPENAPI_SPEC } = require('./src/lib/openapi/spec.ts'); fs.mkdirSync('./docs', { recursive: true }); fs.mkdirSync('./public', { recursive: true }); fs.writeFileSync('./docs/openapi.json', JSON.stringify(PANTRYBOT_OPENAPI_SPEC, null, 2) + '\\n'); fs.writeFileSync('./public/openapi.json', JSON.stringify(PANTRYBOT_OPENAPI_SPEC, null, 2) + '\\n'); console.log('Emitted docs/openapi.json and public/openapi.json');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:regression": "vitest run tests/regression",
    "test:e2e:smoke": "playwright test --project=iphone-webkit --project=ipad-webkit --grep-invert @tier3",
    "test:e2e:regression": "playwright test --project=iphone-webkit --project=ipad-webkit --project=iphone-pro-webkit --project=iphone-pro-max-webkit --project=ipad-landscape-webkit --project=duo-inner-webkit --project=iphone-chromium --project=ipad-chromium",
    "test:e2e:visual": "E2E_FAKE_CLOCK=1 playwright test --project=visual-iphone --project=visual-ipad",
    "test:e2e:update": "E2E_FAKE_CLOCK=1 playwright test --project=visual-iphone --project=visual-ipad --update-snapshots=changed",
    "test:ci:develop": "vitest run tests/unit tests/smoke",
    "test:ci:main": "vitest run tests/unit tests/smoke tests/regression",
    "ci:local": "npm run catalog:build -- --check && npm run design:tokens -- --check && npm run design:palette && npm run typecheck && npm run lint && npm run test:unit && npm run test:smoke && npm run test:regression && npm run build && npm audit --omit=dev --audit-level=critical",
    "ci:local:browser": "npm run ci:local && npm run test:e2e:smoke",
    "ci:local:tier3": "npm run ci:local && npm run test:e2e:regression",
    "market:admin": "node --env-file-if-exists=.env.local --import tsx scripts/market-admin.ts",
    "market:types": "node --import tsx scripts/generate-market-types.mts",
    "design:tokens": "node --import tsx scripts/build-design-tokens.ts",
    "design:palette": "node --import tsx scripts/check-palette-ratchet.ts",
    "catalog:fdc": "node --import tsx scripts/import-fdc-catalog.ts",
    "catalog:curate": "node --import tsx scripts/curate-catalog.ts",
    "catalog:build": "node --import tsx scripts/build-cooking-catalog.ts",
    "catalog:audit-release": "node --import tsx scripts/audit-release-catalog.ts",
    "barcode:prepare-deployment": "node --import tsx scripts/prepare-barcode-deployment.mts",
    "barcode:verify-deployment": "node --import tsx scripts/verify-barcode-deployment.mts",
    "barcode:verify-trace": "node --import tsx scripts/verify-barcode-trace.mts",
    "test:golden:update": "UPDATE_DASHBOARD_GOLDENS=1 vitest run tests/unit/frontend/dashboard-golden-html.test.ts"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "1.73.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-dist": "^5.35.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "axe-core": "4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  }
}
